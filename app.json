{
  "expo": {
    "name": "Recall",
    "slug": "recall-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.recall"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.recall"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "recall",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Recall reads your photos so it can turn your notes into flashcards.",
          "cameraPermission": "Recall uses the camera to scan your notes."
        }
      ],
      "expo-notifications"
    ]
  }
}
